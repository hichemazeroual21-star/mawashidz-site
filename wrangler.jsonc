{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mawashidz-live",
  "main": "worker.mjs",
  // Production: Git → main → Cloudflare Build (npm ci && npm run build) → npx wrangler deploy
  // See DEPLOYMENT.md — Version command must be `npx wrangler versions upload` on non-prod branches.
  "compatibility_date": "2026-07-18",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    // Required when Worker script calls env.ASSETS.fetch — without this, non-API miss paths crash.
    "binding": "ASSETS",
    // All requests pass the Worker so HTTP is redirected before assets and every
    // dynamic response receives the same transport-security headers.
    "run_worker_first": true
  },
  "ratelimits": [
    {
      "name": "LOGIN_IDENTIFIER_RATE_LIMITER",
      "namespace_id": "19001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "LOGIN_IP_RATE_LIMITER",
      "namespace_id": "19002",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Drain email outbox every 2 minutes (requires SUPABASE_* + optional RESEND_API_KEY secrets)
  "triggers": {
    "crons": ["*/2 * * * *"]
  }
}
